# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor/IDE
.idea/
.vscode/

# Temp files from the atomic-write pattern used throughout this project
# (write to .tmp, os.replace over the real file) - shouldn't normally
# linger, but never worth committing if one does
*.tmp
